---
import { SITE } from "@/site.config";
import Status from "@/components/status.astro";
---

<footer class="border-line border-t">
  <div class="mx-auto max-w-3xl">
    <section class="p-3">
      <p
        class="py-3 text-sm font-bold uppercase underline decoration-dotted underline-offset-6"
      >
        let's connect
      </p>

      <div class="flex flex-wrap gap-x-4 gap-y-2 text-xl">
        {
          SITE.social.map((social) => (
            <a
              href={social.href}
              rel="noopener noreferrer"
              class="underline decoration-1 underline-offset-4 transition-colors hover:text-[var(--signal)]"
            >
              {social.label}
            </a>
          ))
        }
      </div>
    </section>

    <div
      class="flex flex-col gap-4 px-3 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <nav class="flex items-center gap-4" aria-label="Social">
        <Status />
      </nav>
    </div>
  </div>
</footer>
