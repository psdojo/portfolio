---
const response = await fetch("https://pranjalsharma.openstatus.dev/feed/json");

const data = await response.json();

const components = data.pageComponents ?? [];

import { IconExternalLink } from "@tabler/icons-astro";

const hasOutage = components.some(
  (component: any) =>
    component.status === "down" || component.status === "degraded",
);

const message = hasOutage
  ? "Some systems are experiencing issues"
  : "All systems operational";
---

<div class="flex items-center gap-2 text-sm">
  <span
    class:list={[
      "h-2 w-2 rounded-full",
      hasOutage ? "bg-yellow-500" : "bg-green-500",
    ]}></span>

  <span>{message}</span>

  <a
    href="https://pranjalsharma.openstatus.dev"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors"
  >
    <IconExternalLink size={20} />
  </a>
</div>
