---
interface Props {
  entry: {
    id: string;
    body?: string;
  };
}

const { entry } = Astro.props;

const title = entry.body?.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? "Untitled";
---

<a
  href={`/work/${entry.id}`}
  class="flex flex-row justify-between border-b-1 border-black py-2 hover:bg-gray-300 active:bg-gray-300 focus:bg-gray-300"
>
  <span>{title}</span>
</a>
