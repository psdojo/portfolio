---
/* ThemeToggle.astro */
---

<button
  id="theme-toggle"
  type="button"
  class="font-mono text-lg font-bold tracking-wide uppercase text-ink-soft hover:text-ink select-none cursor-pointer"
  aria-label="Toggle system color theme"
>
  DARK
</button>

<script is:inline>
  // 1. Instantly runs inline to check localStorage or system preferences before layout paint
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  const setTheme = (theme) => {
    if (theme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
    localStorage.setItem("theme", theme);
  };

  // Run the theme calculation immediately on initial document parse
  setTheme(getThemePreference());

  // 2. CLASSIC FIX: Directly bind click listeners on classic DOM window attachment
  const initToggle = () => {
    const toggleBtn = document.getElementById("theme-toggle");
    if (!toggleBtn) return;

    // Clean up old listeners if any are hanging
    toggleBtn.removeEventListener("click", handleToggleClick);
    toggleBtn.addEventListener("click", handleToggleClick);
  };

  const handleToggleClick = () => {
    const currentTheme = document.documentElement.classList.contains("dark")
      ? "dark"
      : "light";
    const nextTheme = currentTheme === "dark" ? "light" : "dark";
    setTheme(nextTheme);
  };

  // Run the button binding logic as soon as the HTML elements hit the script parser
  initToggle();
</script>
