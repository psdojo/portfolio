---
import "@/styles/starwind.css";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import { SITE, NAV_LINKS } from "@/site.config";

const currentPath = Astro.url.pathname;

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale} class="light">
  <head>
    <BaseHead title={title} description={description} />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="min-h-screen">
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col">
      <main class="flex-1">
        <nav
          class="flex flex-wrap items-center justify-start gap-x-4 gap-y-2 px-3 py-6"
          aria-label="Primary"
        >
          {
            NAV_LINKS.map((link, index) => {
              const isActive =
                currentPath === link.href ||
                currentPath.startsWith(`${link.href}/`);

              return (
                <div class="flex items-center gap-x-4">
                  <a
                    href={link.href}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "font-mono text-2xl font-bold tracking-wide uppercase",
                      isActive ? "text-signal" : "text-ink-soft hover:text-ink",
                    ]}
                  >
                    {link.label}
                  </a>

                  {index < NAV_LINKS.length - 1 && (
                    <span
                      class="transform select-none font-mono text-base font-black italic tracking-tighter text-black opacity-70 antialiased scale-y-125 rotate-6"
                      style="text-shadow: 1px 1px 0px rgba(255, 0, 0, 0.15), -1px -1px 0px rgba(0, 0, 255, 0.15);"
                      aria-hidden="true"
                    >
                      //
                    </span>
                  )}
                </div>
              );
            })
          }

          <span
            class="mx-2 h-4 w-px select-none bg-[var(--line)]"
            aria-hidden="true"></span>
        </nav>

        <div>
          <slot />
        </div>
      </main>

      <Footer />
    </div>
  </body>
</html>
