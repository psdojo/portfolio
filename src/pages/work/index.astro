---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WorkRow from "@/components/WorkRow.astro";

const posts = import.meta.glob("../../work/*.md", {
  eager: true,
  query: "?raw",
  import: "default",
});

const allWork = Object.entries(posts).map(([path, markdown]) => {
  const content = markdown as string;
  const match = content.match(/^#\s+(.+)$/m);

  return {
    id: path.split("/").pop()?.replace(".md", "") ?? "",
    title: match?.[1]?.trim() ?? "Untitled",
  };
});
---

<BaseLayout
  title="Work"
  description="Selected projects in product design and frontend engineering."
>
  <section class="mx-auto max-w-3xl px-3">
    <div>
      {allWork.map((entry) => <WorkRow entry={entry} />)}
    </div>
  </section>
</BaseLayout>
